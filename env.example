# Copy this file to .env and fill in real values. Never commit .env itself.

# A GitHub personal access token. Read-only is enough (public_repo).
# Without a token GitHub allows only 60 requests per hour.
GITHUB_TOKEN=

# The main AI model. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional backup, used if Gemini fails. https://openrouter.ai/keys
# The models it tries are listed in github_analyser/llm.py (OPENROUTER_MODELS).
OPENROUTER_API_KEY=

# Optional limits. These are the defaults.
# DAILY_REVIEW_LIMIT=50          AI reviews per day, shared by all visitors
# REVIEW_DEADLINE_SECONDS=12     the longest one AI model may take
# REVIEW_BUDGET_SECONDS=20       the longest a whole review may take, across all models
